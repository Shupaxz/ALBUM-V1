  if(G.door===false&&(c.riding||nearLift(c))){hintMsg="ประตูลิฟต์ปิดอยู่ · รอ MC เปิดประตู";hintUntil=time+2;tone(180,.15,"square",.04);return}
  if(c.riding){c.riding=false;c.x=LX+(Math.random()-.5)*2;c.z=LZ+HH+1.1;c.y=0;c.vy=0;c.on=true;blip(330,.08)}
  else if(nearLift(c)){c.riding=true;c.x=LX+(Math.random()-.5)*1.4;c.z=LZ+.1+Math.random()*.8;c.rot=Math.PI;c.y=lift.y;c.vy=0;c.on=true;blip(660,.08);emit(24,1)}
}

