.tcust{grid-template-columns:1fr auto}
.tcust input[type=text]{font-size:13px;padding:6px 8px}
#pTab{position:absolute;top:50%;right:284px;transform:translateY(-50%);writing-mode:vertical-rl;padding:16px 7px;border-radius:8px 0 0 8px;background:linear-gradient(180deg,var(--pur),#4a1fb8);border:1px solid rgba(255,255,255,.3);border-right:none;color:#fff;font:800 13px var(--disp);letter-spacing:.12em;z-index:4;box-shadow:-6px 0 18px rgba(0,0,0,.45);transition:right .5s cubic-bezier(.2,1.2,.4,1)}
