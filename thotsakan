#qcard.prep .qc-photo canvas{animation:prepP .45s ease-in-out infinite alternate}
@keyframes prepP{to{filter:brightness(1.6) drop-shadow(0 0 0 #fff)}}
.kr{display:flex;align-items:center;gap:6px;background:#fff;color:var(--ink);transform:skewX(-14deg);padding:5px 12px;border-left:7px solid var(--grn);margin-bottom:6px;font:800 16px var(--disp)}
.kr.r{border-left-color:var(--pur)}
.kr .nm{flex:1;min-width:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.k{width:24px;height:24px;border-radius:50%;border:2.5px solid var(--ink);background:#fff;display:inline-flex;align-items:center;justify-content:center;font:900 14px/1 var(--ui);color:#fff;flex:none;box-sizing:border-box}
.k.o{background:var(--grn);border-color:#0a6a48}.k.o::after{content:"✓"}
.k.x{background:var(--red);border-color:#7a0018}.k.x::after{content:"✗"}
.c6vs{align-self:center;display:flex;align-items:center;gap:8px;margin-bottom:14px;filter:drop-shadow(0 6px 10px rgba(0,0,0,.5));animation:vsDrop .55s cubic-bezier(.2,1.5,.4,1) both}
@keyframes vsDrop{from{transform:translateY(-50px) scale(.7);opacity:0}}
.c6vs .tp{display:flex;align-items:center;gap:6px;background:var(--paper);color:var(--ink);transform:skewX(-14deg);padding:3px 12px 3px 4px;font:800 15px var(--disp);box-shadow:0 0 0 3px var(--grn);max-width:200px}
.c6vs .tp span{white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.c6vs .tp.r{flex-direction:row-reverse;padding:3px 4px 3px 12px;box-shadow:0 0 0 3px var(--pur)}
.c6vs canvas{width:40px;height:40px;image-rendering:pixelated;flex:none}
.c6vs .ks{display:flex;gap:4px;background:var(--ink);padding:5px 8px;transform:skewX(-14deg)}
.c6vs .vsm{font:900 22px var(--disp);color:var(--or1);background:var(--ink);padding:4px 12px;transform:skewX(-14deg)}
.mlogo em{font-style:normal}
@media (max-width:700px){.qc-kicks{right:auto;left:0;top:100%;width:100%;margin-top:8px}.c6vs .tp{max-width:110px;font-size:12px}.c6vs canvas{width:28px;height:28px}}

/* question card: living frames */
@property --ang{syntax:"<angle>";inherits:false;initial-value:0deg}
@keyframes spinB{to{--ang:360deg}}
@keyframes sheen{0%,55%{transform:translateX(-170%) skewX(-20deg)}100%{transform:translateX(280%) skewX(-20deg)}}
.qc-cat{overflow:hidden}
.qc-cat::after,.qc-ans::after,.kr::after,.qc-time::after{content:"";position:absolute;top:0;bottom:0;left:0;width:38%;background:linear-gradient(90deg,transparent,rgba(255,255,255,.8),transparent);animation:sheen 3.2s ease-in-out infinite;pointer-events:none}
.qc-ans::after{animation-delay:.5s}.qc-time::after{animation-delay:1s}.kr::after{animation-delay:1.4s}
.qc-photo::after{content:"";position:absolute;inset:-7px;border:5px solid transparent;border-image:conic-gradient(from var(--ang),rgba(255,255,255,0) 0 52%,#fff 66%,#3df5d0 75%,#ff3df0 86%,rgba(255,255,255,0) 96%) 1;animation:spinB 2.6s linear infinite;pointer-events:none}
