<title>ทศกัณฐ์ รันวงการ</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Kanit:wght@600;800;900&family=Prompt:wght@500;600;700&family=Russo+One&display=swap">
<style>
/* Layout: full-bleed 3D studio; broadcast graphics float over it (scoreboard top-left, question card left, 6-category lower third, VS lower-centre); MC panel docked right for the host only */
:root{
  color-scheme:dark;
  --bg:#070a24; --panel:rgba(10,12,40,.9); --line:#34408f; --fg:#f1f2ff; --dim:#a4abdc;
  --grn:#19e3a0; --pur:#8a4dff; --pink:#ff3df0; --or1:#ff9a1f; --or2:#ffc23d; --red:#ff2d4a; --ink:#111118; --paper:#f1f1f6;
  --ui:"Prompt","Leelawadee UI","Thonburi",system-ui,sans-serif;
  --disp:"Kanit","Prompt","Leelawadee UI",sans-serif;
}
[hidden]{display:none!important}
html,body{height:100%}
body{background:var(--bg);color:var(--fg);font-family:var(--ui);overflow:hidden;touch-action:none;user-select:none;-webkit-user-select:none}
#app{position:relative;height:100%;width:100%;overflow:hidden}
#app.shake{animation:shake .5s linear}
@keyframes shake{20%{transform:translate(-9px,5px)}40%{transform:translate(8px,-6px)}60%{transform:translate(-6px,-4px)}80%{transform:translate(5px,4px)}}
canvas#gl{position:absolute;inset:0;width:100%;height:100%;display:block;cursor:grab;z-index:0}
canvas#gl.drag{cursor:grabbing}
button{font-family:var(--ui);font-weight:700;font-size:13px;color:var(--fg);background:#161b55;border:1px solid var(--line);padding:8px;cursor:pointer;border-radius:2px;line-height:1.25}
button:hover{border-color:var(--grn)}
button:active{transform:translateY(1px)}
button:focus-visible,input:focus-visible,a:focus-visible{outline:2px solid var(--or2);outline-offset:2px}
input[type=text]{box-sizing:border-box;font:700 16px var(--ui);color:var(--fg);background:#0c1040;border:1px solid var(--line);padding:9px 10px;min-width:0;width:100%;user-select:text;-webkit-user-select:text}

.hud{position:absolute;left:16px;top:calc(14px + env(safe-area-inset-top,0px));display:flex;flex-direction:column;gap:7px;pointer-events:none;max-width:calc(100% - 32px)}
.brand{font:900 26px/1 var(--disp);color:#fff;text-shadow:3px 3px 0 var(--pur),-2px -2px 0 var(--grn)}
.brand small{display:block;font:700 11px var(--ui);letter-spacing:.2em;color:var(--grn);text-shadow:none;margin-bottom:4px}
.sb{display:flex;gap:10px;flex-wrap:wrap;padding-left:4px}
.tm{display:flex;align-items:stretch;transform:skewX(-14deg);background:var(--paper);color:var(--ink);font-weight:700;font-size:13px;box-shadow:-4px 4px 0 var(--grn)}
.tm.r{box-shadow:-4px 4px 0 var(--pur)}
.tm.on{outline:3px solid var(--or2)}
.tm span{padding:4px 9px;display:block}
.tm .tn{max-width:110px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.tm .bg{background:var(--ink);color:var(--or2)}
.tm .ls{background:var(--grn);font-variant-numeric:tabular-nums}
.tm.r .ls{background:var(--pur);color:#fff}
.chips{display:flex;gap:6px;flex-wrap:wrap}
.chip{background:var(--panel);border:1px solid var(--line);padding:3px 9px;font-size:12px;font-variant-numeric:tabular-nums}
.chip b{color:var(--grn)}
.chip.air{border-color:var(--red);color:var(--red);font-weight:700;animation:blink 1s steps(2) infinite}
@keyframes blink{50%{opacity:.35}}
.help{position:absolute;left:16px;bottom:calc(12px + env(safe-area-inset-bottom,0px));font-size:11.5px;color:var(--dim);background:var(--panel);border:1px solid var(--line);padding:5px 9px;pointer-events:none}
.hint{position:absolute;left:50%;bottom:calc(120px + env(safe-area-inset-bottom,0px));transform:translateX(-50%) skewX(-10deg);background:var(--ink);border-left:6px solid var(--grn);color:#fff;padding:7px 16px;font-weight:700;font-size:14px;pointer-events:none;white-space:nowrap;max-width:calc(100% - 32px);overflow:hidden;text-overflow:ellipsis}
.note{position:absolute;left:50%;top:36%;transform:translate(-50%,-50%) skewX(-10deg);background:var(--ink);border-left:8px solid var(--grn);border-right:8px solid var(--pur);padding:14px 26px;font:900 24px var(--disp);text-align:center;pointer-events:none;max-width:calc(100% - 48px)}
.note b{color:var(--or2);font-size:1.5em;letter-spacing:.06em}

#qcard{position:absolute;left:26px;top:calc(112px + env(safe-area-inset-top,0px));width:clamp(260px,min(31vw,calc((100vh - 230px)*.66)),460px);display:flex;flex-direction:column;pointer-events:none;filter:drop-shadow(0 10px 18px rgba(0,0,0,.55));animation:cardIn .5s cubic-bezier(.2,1.5,.4,1)}
@keyframes cardIn{from{transform:translateX(-120%) rotate(-8deg);opacity:0}}
.qc-cat{position:relative;z-index:2;align-self:flex-start;max-width:100%;margin-left:-6px;padding:4px 24px;background:linear-gradient(90deg,var(--or1),var(--or2));color:var(--ink);font:900 21px var(--disp);transform:skewX(-14deg);box-shadow:-5px 5px 0 #fff,6px -5px 0 var(--pur),-9px 9px 0 var(--ink)}
.qc-cat span{display:block;transform:skewX(14deg);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.qc-photo{position:relative;margin:10px 26px 0 12px;background:#fff;padding:8px;box-shadow:-8px 8px 0 var(--grn),8px -8px 0 var(--pur)}
.qc-photo canvas{display:block;width:100%;aspect-ratio:4/5;image-rendering:pixelated;border:3px solid var(--ink);background:#000;box-sizing:border-box}
#qcard .qc-cat{animation:slideL .55s cubic-bezier(.2,1.4,.4,1) both}
#qcard .qc-photo{animation:rise .6s .1s cubic-bezier(.2,1.3,.4,1) both}
#qcard .qc-bar{animation:slideU .55s .22s cubic-bezier(.2,1.4,.4,1) both}
#qcard .qc-ts{animation:drop .55s .34s cubic-bezier(.2,1.6,.4,1) both}
#qcard .qc-photo.pop{animation:flip .7s cubic-bezier(.3,1.2,.5,1)}
@keyframes slideL{from{transform:translateX(-140%) skewX(-14deg)}}
@keyframes rise{from{transform:translateY(60px) scale(.7) rotate(-4deg);opacity:0}}
@keyframes slideU{from{transform:translateY(140%) skewX(-14deg);opacity:0}}
@keyframes drop{from{transform:translateY(-90px) rotate(8deg);opacity:0}}
@keyframes flip{0%{transform:perspective(700px) rotateY(-180deg) scale(.82);filter:brightness(0)}45%{filter:brightness(0)}55%{filter:brightness(2.4)}80%{transform:perspective(700px) rotateY(9deg) scale(1.05)}100%{transform:none;filter:none}}
@keyframes pop{from{transform:scale(.6);filter:brightness(3)}}
.qc-bar{display:flex;align-items:flex-end;margin:12px 0 0 8px;transform:skewX(-14deg)}
.qc-ans{flex:1;min-width:0;position:relative;background:var(--paper);color:var(--ink);font-weight:700;font-size:13px;padding:8px 8px 8px 30px;box-shadow:-5px 5px 0 var(--grn),0 5px 0 var(--pur);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.qc-ans::before{content:"";position:absolute;left:8px;top:11px;width:14px;height:3px;background:var(--or1);box-shadow:4px 6px 0 var(--ink)}
.qc-ans.rev{color:#3bff00;font-family:var(--disp);font-weight:900;font-size:1.4em;text-align:center;padding-left:8px;-webkit-text-stroke:1.5px #0a4a00;paint-order:stroke fill;animation:pop .45s cubic-bezier(.2,1.7,.4,1)}
.qc-ans.rev::before{display:none}
.qc-ans.rev.sk{color:#ff9a1f;-webkit-text-stroke-color:#5a2a00}
.qc-ans.rev.fo{color:#ff2d4a;-webkit-text-stroke-color:#4a0010}
.qc-ts{width:86px;flex:none;box-shadow:5px 5px 0 var(--pur)}
.qc-time{background:var(--pur);color:#fff;font:700 15px var(--ui);text-align:center;padding:2px 0;border-top:5px solid var(--grn);font-variant-numeric:tabular-nums}
.qc-time.low{background:var(--red);animation:blink .5s steps(2) infinite}
.qc-score{background:#fff;color:var(--ink);font:900 30px/1.2 var(--disp);text-align:center;font-variant-numeric:tabular-nums}
.qc-score.bump{animation:pop .35s}
@media (min-width:701px){
  .qc-cat{font-size:32px;padding:6px 36px}
  .qc-photo{padding:12px;margin:16px 40px 0 16px}
  .qc-bar{margin-top:18px}
  .qc-ans{font-size:19px;padding:14px 8px 14px 40px}
  .qc-ans::before{top:19px}
  .qc-ts{width:150px}.qc-time{font-size:24px;padding:3px 0}.qc-score{font-size:56px}
  .qc-cat.long{font-size:23px;padding:9px 28px}
}
#tbar{position:absolute;left:0;right:0;top:0;height:6px;background:rgba(255,255,255,.08);pointer-events:none}
#tbar i{display:block;height:100%;width:100%;transform-origin:left;background:linear-gradient(90deg,var(--grn),var(--pur))}
#tbar.low i{background:var(--red)}

#vs{position:absolute;left:50%;bottom:calc(22px + env(safe-area-inset-bottom,0px));transform:translateX(-50%);display:flex;align-items:flex-end;pointer-events:none;animation:vsIn .5s cubic-bezier(.2,1.4,.4,1);filter:drop-shadow(0 8px 14px rgba(0,0,0,.5))}
@keyframes vsIn{from{transform:translateX(-50%) translateY(140%)}}
.pl{display:flex;align-items:flex-end;gap:6px;height:56px;padding:0 12px 6px 8px;background:var(--paper);transform:skewX(-14deg);box-shadow:0 0 0 4px var(--grn),-9px 7px 0 4px var(--ink)}
.pl.r{flex-direction:row-reverse;box-shadow:0 0 0 4px var(--pur),9px 7px 0 4px var(--ink)}
.pl canvas{width:66px;height:66px;image-rendering:pixelated;transform:skewX(14deg)}
.pl .nm{background:var(--ink);color:#fff;font:900 17px var(--disp);padding:1px 12px;max-width:150px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.pl .pt{font:900 30px/1 var(--disp);color:var(--ink);min-width:24px;text-align:center}
.pl.turn .nm{background:var(--or1);color:var(--ink)}
.vsx{z-index:1;margin:0 -2px 8px;background:var(--ink);color:var(--or1);font:900 30px/1 var(--disp);padding:6px 16px;transform:skewX(-14deg)}

#under{position:absolute;right:16px;bottom:calc(26px + env(safe-area-inset-bottom,0px));display:flex;align-items:flex-end;pointer-events:none;filter:drop-shadow(0 0 14px rgba(255,45,74,.9));animation:undIn .55s cubic-bezier(.2,1.4,.4,1),undGlow .9s ease-in-out .55s infinite alternate}
#app.mc #under{right:300px}
@keyframes undIn{from{transform:translateX(140%) skewX(-20deg)}}
@keyframes undGlow{to{filter:drop-shadow(0 0 3px rgba(255,45,74,.35))}}
#under .tri{position:relative;z-index:2;width:124px;height:108px;background:#ff2d4a;clip-path:polygon(50% 0,100% 100%,0 100%);display:flex;align-items:flex-end;justify-content:center;padding-bottom:13px;box-sizing:border-box}
#under .tri::before{content:"";position:absolute;left:10px;right:10px;top:16px;bottom:6px;background:linear-gradient(#ff6a7c,#a3001c);clip-path:polygon(50% 0,100% 100%,0 100%)}
#under .tri span{position:relative;font:900 22px var(--disp);color:#fff;text-shadow:0 0 10px #fff}
#under .ub{margin:0 0 8px -26px;display:flex;flex-direction:column;transform:skewX(-14deg)}
#under .ub b{background:#fff;color:var(--red);font:900 21px var(--disp);padding:7px 22px 7px 38px;white-space:nowrap;border-top:3px solid var(--red)}
#under .ub i{display:block;height:13px;background:repeating-linear-gradient(-45deg,var(--red) 0 10px,#111118 10px 20px);background-size:28px 28px;animation:haz .8s linear infinite}
@keyframes haz{to{background-position:28px 0}}

/* 6-category lower third */
#c6{position:absolute;left:16px;right:16px;margin:0 auto;max-width:1000px;bottom:calc(30px + env(safe-area-inset-bottom,0px));display:flex;flex-direction:column;align-items:flex-start;animation:c6In .55s cubic-bezier(.2,1.4,.4,1)}
#app.mc #c6{right:300px}
@keyframes c6In{from{transform:translateY(130%) skewX(-8deg);opacity:0}}
.c6t{position:relative;z-index:2;margin:0 0 -6px 34px;background:var(--ink);color:#fff;font:900 20px var(--disp);padding:5px 22px;transform:skewX(-14deg);border-left:6px solid var(--or1);border-right:6px solid var(--grn);max-width:calc(100% - 60px);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.c6w{width:100%;box-sizing:border-box;background:linear-gradient(180deg,#a052ff,#6a2ee0);border:3px solid #d2b4ff;padding:20px 30px 22px;transform:skewX(-8deg);box-shadow:0 11px 0 var(--or1),0 22px 30px rgba(0,0,0,.5)}
.c6g{display:grid;grid-template-columns:repeat(3,1fr);gap:16px 26px;transform:skewX(8deg)}
.c6g button{position:relative;min-width:0;background:var(--paper);color:var(--ink);border:none;font:900 clamp(13px,1.45vw,19px) var(--disp);padding:11px 8px;transform:skewX(-14deg);box-shadow:-7px 5px 0 #3df5d0,7px 6px 0 var(--ink);transition:transform .12s,background .12s;cursor:default}
.c6g button span{display:block;transform:skewX(14deg);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.c6g button.hot{background:linear-gradient(90deg,var(--or1),var(--or2));transform:skewX(-14deg) scale(1.07)}
.c6g button.win{background:linear-gradient(90deg,var(--or1),var(--or2));animation:winP .45s ease-in-out infinite alternate}
@keyframes winP{to{transform:skewX(-14deg) scale(1.1);box-shadow:-7px 5px 0 #fff,7px 6px 0 var(--ink),0 0 34px var(--or2)}}
.c6g button.u0{background:var(--grn);opacity:.42}
.c6g button.u1{background:var(--pur);color:#fff;opacity:.42}
.c6g button.pick{cursor:pointer}
.c6g button.pick:hover{background:var(--or2);transform:skewX(-14deg) translateY(-4px)}

#bonus{position:absolute;left:50%;bottom:calc(20px + env(safe-area-inset-bottom,0px));transform:translateX(-50%);display:flex;flex-direction:column;align-items:center;gap:10px;width:min(560px,calc(100% - 32px))}
.bhead{display:flex;gap:8px;align-items:center;flex-wrap:wrap;justify-content:center}
.bhead .t{font:900 20px var(--disp);background:linear-gradient(90deg,var(--or1),var(--or2));color:var(--ink);padding:3px 18px;transform:skewX(-14deg)}
.hands{font:900 20px var(--disp);background:var(--ink);padding:3px 14px;color:var(--or2)}
.clues{display:grid;grid-template-columns:repeat(5,1fr);gap:8px;width:100%}
.clue{background:#fff;padding:4px;box-shadow:-4px 4px 0 var(--grn),4px -4px 0 var(--pur);display:flex;flex-direction:column;gap:2px;min-width:0}
.clue canvas{width:100%;aspect-ratio:1;image-rendering:pixelated;background:var(--ink)}
.clue span{color:var(--ink);font-weight:700;font-size:12px;text-align:center;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.clue.new canvas{animation:flip .6s}
#wb{position:absolute;left:16px;bottom:calc(16px + env(safe-area-inset-bottom,0px));background:var(--panel);border:1px solid var(--line);padding:8px;display:flex;flex-direction:column;gap:6px;width:min(300px,calc(100% - 32px))}
#wb canvas{width:100%;aspect-ratio:3/2;background:#fff;touch-action:none;cursor:crosshair}
#wb div{display:flex;gap:6px;align-items:center;font-size:12px;color:var(--dim)}
#wb div span{flex:1}

#big{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;pointer-events:none;padding:16px;text-align:center}
#big span{font:900 min(15vw,150px)/1 var(--disp);color:#fff;-webkit-text-stroke:3px var(--ink);text-shadow:6px 6px 0 var(--pur),-4px -4px 0 var(--grn);animation:sting .45s cubic-bezier(.2,1.7,.4,1);text-wrap:balance}
#big.long span{font-size:min(9vw,92px)}
#big.ok span{text-shadow:6px 6px 0 var(--grn),0 0 50px var(--grn)}
#big.bad span,#big.foul span{text-shadow:6px 6px 0 var(--red),0 0 50px var(--red)}
#big.foul{border:16px solid var(--red);animation:fl .2s steps(2) 8}
#big.gold span{color:var(--or2);text-shadow:6px 6px 0 var(--pur),0 0 60px var(--or1)}
@keyframes sting{from{transform:scale(3) rotate(-6deg);opacity:0}}
@keyframes fl{50%{border-color:transparent;background:rgba(255,45,74,.16)}}
#flash{position:absolute;inset:0;pointer-events:none;animation:flashA .75s ease-out forwards}
#flash.g{background:radial-gradient(circle,rgba(25,227,160,0) 25%,rgba(25,227,160,.6))}
#flash.r{background:radial-gradient(circle,rgba(255,45,74,0) 25%,rgba(255,45,74,.65))}
#flash.y{background:radial-gradient(circle,rgba(255,194,61,0) 25%,rgba(255,194,61,.6))}
@keyframes flashA{from{opacity:1}to{opacity:0}}
#wipe{position:absolute;inset:0;pointer-events:none;overflow:hidden}
#wipe i{position:absolute;top:-20%;bottom:-20%;width:46%;left:-70%;transform:skewX(-20deg);animation:wipeA .9s cubic-bezier(.6,0,.3,1) forwards}
#wipe i:nth-child(1){background:var(--grn)}
#wipe i:nth-child(2){background:var(--pur);animation-delay:.08s}
#wipe i:nth-child(3){background:var(--or1);animation-delay:.16s}
@keyframes wipeA{to{left:140%}}
#app.tense::after{content:"";position:absolute;inset:0;pointer-events:none;box-shadow:inset 0 0 130px 34px rgba(255,45,74,.6);animation:blink 1s ease-in-out infinite}

.panel{position:absolute;right:16px;top:calc(12px + env(safe-area-inset-top,0px));width:268px;max-height:calc(100% - 24px);overflow:auto;background:var(--panel);border:1px solid var(--line);padding:10px;display:flex;flex-direction:column;gap:8px;backdrop-filter:blur(6px);touch-action:pan-y}
.panel h2{margin:0;font:900 18px var(--disp);color:var(--or2)}
.blk{display:flex;flex-direction:column;gap:5px;padding:7px;border-left:4px solid var(--grn);background:rgba(255,255,255,.035)}
.blk.b2{border-color:var(--or1)}.blk.b3{border-color:var(--pur)}.blk.b5{border-color:var(--or2)}.blk.b4{border-color:var(--pink)}
.blk h4{margin:0;font-size:11px;letter-spacing:.08em;color:var(--dim);font-weight:700}
.row{display:grid;grid-template-columns:1fr 1fr;gap:5px}
.row.one{grid-template-columns:1fr}
button i{font-style:normal;color:var(--dim);font-size:10px;margin-right:4px}
.ok{background:#0b4636;border-color:var(--grn);color:var(--grn)}
.skip{background:#4a3606;border-color:var(--or2);color:var(--or2)}
.bad{background:#4a0c1a;border-color:var(--red);color:var(--red)}
.act{background:var(--pur);border-color:var(--pur)}
.prev{display:flex;gap:9px;align-items:center;font-size:12px;color:var(--dim)}
.prev canvas{width:66px;height:66px;image-rendering:pixelated;border:1px solid var(--line);background:#000;flex:none}
.prev div{min-width:0}
#pMsg{color:var(--fg);font-weight:700}
.vol{display:flex;align-items:center;gap:8px;font-size:12px;color:var(--dim)}
.vol input{flex:1;min-width:0;accent-color:var(--grn)}
#toggle{position:absolute;right:16px;top:calc(12px + env(safe-area-inset-top,0px));display:none}

#menu{position:absolute;inset:0;background:linear-gradient(180deg,rgba(5,6,24,.3),rgba(5,6,24,.84));display:flex;align-items:flex-start;justify-content:center;padding:16px;overflow:auto;touch-action:pan-y}
#menu .mbox{margin:auto}
.mbox{display:flex;flex-direction:column;align-items:center;gap:16px;width:min(460px,100%);text-align:center}
.mbox.wide{width:min(820px,100%)}
.mlogo{font:900 clamp(54px,13vw,124px)/.92 var(--disp);color:#fff;text-shadow:5px 5px 0 var(--pur),-4px -4px 0 var(--grn),0 0 50px var(--pink);animation:sting .6s cubic-bezier(.2,1.5,.4,1)}
.mlogo small{display:block;font:700 13px var(--ui);letter-spacing:.3em;color:var(--grn);text-shadow:none;margin-bottom:10px}
.mlogo span{display:block;animation:glow 2.2s ease-in-out infinite}
.mlogo em{display:inline-block;font-size:.6em;background:linear-gradient(90deg,var(--or1),var(--or2));color:var(--ink);text-shadow:none;padding:0 .35em;transform:skewX(-10deg) rotate(-3deg);box-shadow:-8px 8px 0 var(--pur),8px -8px 0 var(--grn)}
@keyframes glow{50%{text-shadow:5px 5px 0 var(--pur),-4px -4px 0 var(--grn),0 0 90px var(--pink),0 0 34px #fff}}
.mtag{margin:0;font-weight:700;letter-spacing:.06em;background:var(--ink);padding:7px 18px;transform:skewX(-10deg);border-left:6px solid var(--grn);border-right:6px solid var(--pur)}
.mbtns{display:grid;grid-template-columns:1fr 1fr;gap:18px;width:100%;padding:0 8px;box-sizing:border-box}
.mbig{display:flex;flex-direction:column;gap:5px;align-items:center;font:900 26px var(--disp);padding:22px 8px;border:none;transform:skewX(-10deg);color:var(--ink);background:var(--grn);box-shadow:-7px 7px 0 #fff;transition:transform .15s,box-shadow .15s}
.mbig.p{background:var(--pur);color:#fff}
.mbig b{font:inherit;font-size:36px;line-height:1}
.mbig span{font:700 12px var(--ui)}
.mbig:hover{transform:skewX(-10deg) translateY(-6px) scale(1.04);box-shadow:-10px 12px 0 var(--or2)}
.mform{display:flex;flex-direction:column;gap:10px;width:100%;box-sizing:border-box;text-align:left;background:var(--panel);border:1px solid var(--line);padding:16px}
.mform h3{margin:0;font:900 24px var(--disp);color:var(--or2)}
.mform label{font-size:12px;color:var(--dim);display:flex;flex-direction:column;gap:4px}
.mform .two{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.mform p{margin:4px 0;font-size:13px;color:var(--dim)}
