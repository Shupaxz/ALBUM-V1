.qc-ans::before{animation:dash 1.2s ease-in-out infinite}
@keyframes dash{50%{transform:translateX(5px)}}
.qc-time{position:relative;overflow:hidden;background:repeating-linear-gradient(-45deg,rgba(255,255,255,.1) 0 8px,rgba(255,255,255,0) 8px 16px),var(--pur);background-size:22px 22px,auto;animation:stripes 1s linear infinite}
@keyframes stripes{to{background-position:22px 0,0 0}}
.qc-score{animation:scoreGlow 2.4s ease-in-out infinite}
@keyframes scoreGlow{50%{box-shadow:inset 0 0 0 3px rgba(138,77,255,.35)}}
.kr{position:relative;overflow:hidden;animation:krIn .5s cubic-bezier(.2,1.4,.4,1) both}
.kr.r{animation-delay:.12s}
@keyframes krIn{from{transform:skewX(-14deg) translateX(90px);opacity:0}}
.k.o,.k.x{animation:kPop .55s cubic-bezier(.2,1.8,.4,1)}
@keyframes kPop{from{transform:scale(2.3);box-shadow:0 0 22px #fff}}
.qc-kicks{animation:none}
/* MC panel: glass, live edge, slide in/out */
.panel{background:linear-gradient(160deg,rgba(30,18,82,.95),rgba(8,10,34,.95));border:1px solid rgba(138,77,255,.55);border-radius:8px;box-shadow:0 18px 50px rgba(0,0,0,.55);padding-left:14px;transition:transform .5s cubic-bezier(.2,1.2,.4,1),opacity .35s}
.panel::before{content:"";position:sticky;top:0;align-self:stretch;height:0}
