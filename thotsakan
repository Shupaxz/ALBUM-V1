.blk{border-radius:5px;background:linear-gradient(90deg,rgba(255,255,255,.06),rgba(255,255,255,.02));animation:blkIn .5s cubic-bezier(.2,1.3,.4,1) both}
.blk:nth-of-type(2){animation-delay:.05s}.blk:nth-of-type(3){animation-delay:.1s}.blk:nth-of-type(4){animation-delay:.15s}.blk:nth-of-type(5){animation-delay:.2s}.blk:nth-of-type(6){animation-delay:.25s}.blk:nth-of-type(7){animation-delay:.3s}
