@keyframes slotIn{from{transform:translate(-50%,-50%) scale(.3) rotate(-10deg);opacity:0}}
.sl-t{position:relative;z-index:2;margin-bottom:-6px;background:var(--ink);color:var(--grn);font:900 22px var(--disp);padding:6px 26px;transform:skewX(-14deg);border-left:6px solid var(--or1);border-right:6px solid var(--pur)}
.sl-w{position:relative;width:100%;box-sizing:border-box;height:190px;overflow:hidden;background:linear-gradient(180deg,#a052ff,#5f28d6);border:4px solid #fff;padding:14px 24px;transform:skewX(-8deg);box-shadow:-12px 12px 0 var(--grn),12px -12px 0 var(--or1),0 26px 44px rgba(0,0,0,.55)}
.sl-w::before,.sl-w::after{content:"";position:absolute;left:0;right:0;height:46px;z-index:2;pointer-events:none}
.sl-w::before{top:0;background:linear-gradient(#5f28d6,rgba(95,40,214,0))}
.sl-w::after{bottom:0;background:linear-gradient(rgba(95,40,214,0),#5f28d6)}
.sl-r{display:flex;flex-direction:column;gap:10px;transform:skewX(8deg)}
.sl-r span{display:block;height:48px;line-height:48px;text-align:center;font:900 clamp(20px,3.4vw,38px)/48px var(--disp);color:rgba(255,255,255,.55);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;padding:0 10px}
.sl-r span:nth-child(2){background:var(--paper);color:var(--ink);transform:skewX(-14deg);box-shadow:-7px 5px 0 #3df5d0,7px 6px 0 var(--ink)}
#slot.fast .sl-r span{filter:blur(1.3px)}
#slot.lock .sl-r span:nth-child(2){background:linear-gradient(90deg,var(--or1),var(--or2));animation:winS .42s ease-in-out infinite alternate}
@keyframes winS{to{transform:skewX(-14deg) scale(1.07);box-shadow:-7px 5px 0 #fff,7px 6px 0 var(--ink),0 0 46px var(--or2)}}
.sl-team{margin-top:20px;background:var(--paper);color:var(--ink);font:900 18px var(--disp);padding:4px 24px;transform:skewX(-14deg);box-shadow:-6px 5px 0 var(--grn)}
/* entrance motion for every overlay */
.hud:not([hidden]){animation:hudIn .6s cubic-bezier(.2,1.3,.4,1)}
@keyframes hudIn{from{transform:translateX(-120%);opacity:0}}
.panel:not([hidden]){animation:panIn .55s cubic-bezier(.2,1.3,.4,1)}
@keyframes panIn{from{transform:translateX(120%);opacity:0}}
.hint:not([hidden]){animation:hintIn .45s cubic-bezier(.2,1.6,.4,1)}
@keyframes hintIn{from{transform:translateX(-50%) skewX(-10deg) translateY(-30px) scale(.6);opacity:0}}
.note:not([hidden]){animation:noteIn .55s cubic-bezier(.2,1.6,.4,1)}
@keyframes noteIn{from{transform:translate(-50%,-50%) skewX(-10deg) scale(.2) rotate(-6deg);opacity:0}}
#bonus:not([hidden]){animation:c6In .55s cubic-bezier(.2,1.4,.4,1)}
.tm.on{animation:tmP 1s ease-in-out infinite alternate}
@keyframes tmP{to{outline-color:#fff;box-shadow:-4px 4px 0 var(--or2),0 0 18px var(--or2)}}
.c6g button{animation:plateIn .5s cubic-bezier(.2,1.5,.4,1) both}
.c6g button:nth-child(2){animation-delay:.05s}.c6g button:nth-child(3){animation-delay:.1s}.c6g button:nth-child(4){animation-delay:.15s}.c6g button:nth-child(5){animation-delay:.2s}.c6g button:nth-child(6){animation-delay:.25s}
@keyframes plateIn{from{transform:skewX(-14deg) translateY(30px) scale(.6);opacity:0}}
.mbox:not([hidden]){animation:boxIn .5s cubic-bezier(.2,1.4,.4,1)}
@keyframes boxIn{from{transform:translateY(40px) scale(.92);opacity:0}}
/* join screens */
.jhead{display:flex;flex-direction:column;align-items:center;gap:6px}
.jhead small{font:700 13px var(--ui);letter-spacing:.32em;color:var(--grn)}
.jhead b{font:900 clamp(34px,8vw,58px)/1 var(--disp);color:#fff;text-shadow:4px 4px 0 var(--pur),-3px -3px 0 var(--grn),0 0 40px var(--pink);text-wrap:balance}
.pinbox{position:relative;display:grid;grid-template-columns:repeat(4,1fr);gap:14px;width:min(380px,100%);padding:0 10px;box-sizing:border-box;cursor:text}
.pinbox input{position:absolute;inset:0;width:100%;height:100%;opacity:0;font-size:16px;border:none;cursor:text}
.pinbox span{display:flex;align-items:center;justify-content:center;aspect-ratio:3/4;background:var(--paper);color:var(--ink);font:900 clamp(40px,10vw,64px)/1 var(--disp);transform:skewX(-10deg);box-shadow:-7px 7px 0 var(--grn),7px -7px 0 var(--pur);position:relative}
.pinbox span.cur::after{content:"";position:absolute;left:22%;right:22%;bottom:14%;height:5px;background:var(--or1);animation:blink .8s steps(2) infinite}
.pinbox:focus-within span{box-shadow:-7px 7px 0 var(--grn),7px -7px 0 var(--pur),0 0 24px rgba(255,194,61,.55)}
.mbig.go2{width:min(380px,100%);box-sizing:border-box}
.bigname{font:900 26px var(--disp)!important;text-align:center;padding:12px!important;border:2px solid var(--line)!important;transform:skewX(-8deg)}
.tpick{width:100%}
.tpick button{position:relative;overflow:hidden;min-height:150px;justify-content:center;transition:transform .15s,box-shadow .15s}
.tpick button:not(:disabled):hover{transform:skewX(-10deg) translateY(-6px) scale(1.03);box-shadow:-9px 12px 0 var(--or2)}
.tpick button .num{position:absolute;right:8px;top:-18px;font:900 130px/1 var(--disp);opacity:.18}
.tpick button b{font:900 28px var(--disp);position:relative}
.tpick button .mem{font:700 12px var(--ui);position:relative;opacity:.85;max-width:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.glinks{display:grid;grid-template-columns:1fr 1fr;gap:3px}
.glinks .gbtn{font-size:10.5px;padding:4px 2px}
.glinks .gbtn.w{background:var(--grn)}
.qc-cr{position:absolute;left:14px;right:14px;bottom:14px;font:500 9px/1.3 var(--ui);color:#fff;background:rgba(0,0,0,.55);padding:2px 5px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.qc-cr:empty{display:none}
.credits{font-size:12px;color:var(--dim)}
.credits summary{cursor:pointer;font-weight:700;color:var(--fg)}
#credList{display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:3px 12px;margin-top:8px;max-height:260px;overflow:auto}
#credList a{color:var(--grn)}

/* 3D game title card */
#tcard{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;pointer-events:none;z-index:60;overflow:hidden;visibility:hidden;--tc:#b44dff;--tg:rgba(255,61,240,.85);--d:2600ms}
#tcard.v-gold{--tc:#ff9a1f;--tg:rgba(255,194,61,.9)}
#tcard.v-bad,#tcard.v-foul{--tc:#ff2d4a;--tg:rgba(255,45,74,.9)}
#tcard.v-ok{--tc:#19e3a0;--tg:rgba(25,227,160,.9)}
.tc-streak{position:absolute;left:-10%;right:-10%;top:60%;height:5px;background:linear-gradient(90deg,transparent,var(--tc) 25%,#fff 50%,#3df5d0 75%,transparent);box-shadow:0 0 34px 10px var(--tg);animation:streak var(--d) ease-out both}
.tc-flare{position:absolute;left:50%;top:60%;width:340px;height:340px;margin:-170px 0 0 -170px;background:radial-gradient(circle,rgba(255,255,255,.95),rgba(255,255,255,0) 60%);animation:flare var(--d) ease-out both}
.tc-in{position:relative;display:flex;flex-direction:column;align-items:center;animation:tcIn var(--d) cubic-bezier(.2,1.1,.3,1) both;text-align:center;padding:0 16px;overflow:hidden}
#tcard.on{visibility:visible}
#app.mc:not(.poff) #tcard{right:290px}
@media (max-width:700px){#app.mc:not(.poff) #tcard{right:0}}
#tcard:not(.on) *{animation:none!important}
.tc-in::after{content:"";position:absolute;top:-20%;bottom:-20%;left:0;width:30%;background:linear-gradient(90deg,rgba(255,255,255,0),rgba(255,255,255,.35),rgba(255,255,255,0));animation:tcSweep var(--d) linear both;pointer-events:none}
@keyframes tcSweep{0%,8%{transform:translateX(-120%) skewX(-20deg)}30%,100%{transform:translateX(420%) skewX(-20deg)}}
#tcard b,#tcard small{display:block;font-family:var(--disp);font-weight:900;line-height:1.08;color:#fff;-webkit-text-stroke:2px var(--tc);paint-order:stroke fill;
  text-shadow:0 1px 0 #7a2ad0,0 2px 0 #6a20c0,0 3px 0 #5a18a8,0 4px 0 #4a1290,0 5px 0 #3a0c78,0 6px 0 #2a0860,0 9px 12px rgba(10,2,30,.85),0 0 28px var(--tg),0 0 60px var(--tg);text-wrap:balance}
#tcard b{font-size:clamp(54px,10.5vw,150px)}
#tcard small{font-size:clamp(30px,5.6vw,80px);margin-bottom:.06em}
@keyframes tcIn{0%{transform:scale(2.8) skewX(-16deg);opacity:0;filter:blur(8px)}7%{transform:scale(.92) skewX(3deg);opacity:1;filter:blur(0)}11%{transform:scale(1) skewX(0)}88%{transform:scale(1.05);opacity:1;filter:blur(0)}94%{transform:scale(1.12) skewX(-6deg);opacity:.9}100%{transform:scale(1.7) skewX(-12deg);opacity:0;filter:blur(10px)}}
@keyframes streak{0%{transform:scaleX(0);opacity:0}9%{transform:scaleX(1);opacity:1}88%{transform:scaleX(1);opacity:1}100%{transform:scaleX(0);opacity:0}}
@keyframes flare{0%,4%{transform:scale(0);opacity:0}9%{transform:scale(1.5);opacity:1}25%{transform:scale(.6);opacity:.45}88%{transform:scale(.6);opacity:.35}93%{transform:scale(1.6);opacity:.9}100%{transform:scale(2.2);opacity:0}}
@keyframes shine{from{background-position:120% 0}to{background-position:-60% 0}}
/* slot: rays + marquee bulbs */
#slot::before{content:"";position:absolute;left:50%;top:50%;width:1100px;height:1100px;margin:-550px 0 0 -550px;background:repeating-conic-gradient(rgba(255,255,255,.13) 0 7deg,transparent 7deg 18deg);border-radius:50%;-webkit-mask:radial-gradient(circle,#000 18%,transparent 62%);mask:radial-gradient(circle,#000 18%,transparent 62%);animation:rays 7s linear infinite;z-index:-1}
#slot.lock::before{animation-duration:1.4s;background:repeating-conic-gradient(rgba(255,194,61,.32) 0 7deg,transparent 7deg 18deg)}
@keyframes rays{to{transform:rotate(360deg)}}
.sl-w{outline:7px dotted var(--or2);outline-offset:8px;animation:bulbs .32s steps(2) infinite}
#slot.lock .sl-w{animation:bulbs .1s steps(2) infinite}
@keyframes bulbs{50%{outline-color:#ff3df0}}
#slot.lock .sl-t{animation:pop .5s}
/* duel card (penalty) */
.qc-kicks{display:none;position:absolute;right:-238px;top:56%;width:252px;flex-direction:column;filter:drop-shadow(0 8px 12px rgba(0,0,0,.5));animation:slideL .5s .3s both}
#qcard.duel .qc-kicks{display:flex}
#qcard.duel .qc-score{display:none}
