const lastSeen={};
function removePlayer(id){const i=G.players.findIndex(p=>p.id===id);if(i<0)return;const nm=G.players[i].name;G.players.splice(i,1);delete lastSeen[id];say(nm+" ออกจากห้อง");commit()}
function openChan(pin){
  try{chan=new BroadcastChannel("thotsakan-"+pin)}catch(e){chan=null}
  if(!chan)return;
  chan.onmessage=ev=>{const m=ev.data||{};
    if(ROLE==="mc"){
      if(m.t==="join")post({t:"state",s:G});
      else if(m.t==="hello"&&m.id){
        lastSeen[m.id]=performance.now();
        if(!G.players.some(p=>p.id===m.id)){
          const team=m.team?1:0;
          if(G.players.filter(p=>p.team===team).length>=4){post({t:"full",id:m.id});return}
          G.players.push({id:m.id,name:String(m.name||"ผู้เล่น").slice(0,12),team});say(m.name+" เข้าร่วม "+G.teams[team]);blip(880,.1);
        }
        commit();
      }
      else if(m.t==="pos"&&m.id&&pchars[m.id]){pchars[m.id].net=m;lastSeen[m.id]=performance.now()}
      else if(m.t==="hb"&&m.id)lastSeen[m.id]=performance.now();
      else if(m.t==="bye"&&m.id)removePlayer(m.id);
      else if(m.t==="bpick"){const p=G.players.find(q=>q.id===m.id);if(p&&p.team===G.champ)openClue(m.i)}
      else if(m.t==="pick"){const p=G.players.find(q=>q.id===m.id);if(p)pickCat(m.i,p.team)}
    }else if(ROLE==="player"){
      if(m.t==="state"){joined=true;Object.assign(G,m.s);render();if(pendingHello&&G.players.some(p=>p.id===myId)){pendingHello=false;enterAsPlayer()}}
      else if(m.t==="fx")doFx(m.n);
      else if(m.t==="title"){bigText(m.b,m.c,3000,m.s);temp(m.c==="gold"?"party":"intro",2.6)}
      else if(m.t==="sfx"&&SFX[m.n])SFX[m.n]();
      else if(m.t==="pos"){if(m.id==="mc")mcChar.net=m;else if(m.id!==myId&&pchars[m.id])pchars[m.id].net=m}
      else if(m.t==="full"&&m.id===myId){pendingHello=false;$("profErr").textContent="ทีมนี้เต็มแล้ว เลือกอีกทีม"}
    }};
}
setInterval(()=>{
  if(ROLE==="player"&&chan&&!pendingHello&&G.players.some(p=>p.id===myId))post({t:"hb",id:myId});
  if(ROLE==="mc"){const now=performance.now();G.players.slice().forEach(p=>{if(lastSeen[p.id]==null)lastSeen[p.id]=now;else if(now-lastSeen[p.id]>75000)removePlayer(p.id)})}
