  if(catNames().length!==bank.length){er.textContent="มีชื่อหมวดซ้ำกัน เปลี่ยนชื่อให้ไม่ซ้ำ";return}
  const imgs=bank.reduce((s,b)=>s+imgCount(b),0);
  if(imgs<20&&!doneWarned){doneWarned=true;er.textContent="ตอนนี้มีรูปจริงแค่ "+imgs+" รูป ช่องที่ไม่มีรูปจะไม่ถูกใช้ และระบบจะเติมหน้าพิกเซลแทน กดปุ่มอีกครั้งถ้าจะไปต่อ";return}
  er.textContent="";for(const k in pools)delete pools[k];
  G.pin=String(1000+rnd(9000));G.teams=[$("tA").value.trim()||"ทีมซ้าย",$("tB").value.trim()||"ทีมขวา"];
  ROLE="mc";G.phase="lobby";openChan(G.pin);$("mPin").textContent=G.pin;show("mWait");sFanfare();wipe();say("ห้องพร้อม กด 2 เริ่มรายการ");commit()};
$("mEnter").onclick=()=>{unlock();yaw=0;pitch=.3;$("menu").hidden=true;wipe();blip(660,.1);render()};
$("mJoin").onclick=()=>{unlock();const pin=$("pinIn").value.trim(),er=$("pinErr");
  if(!/^\d{4}$/.test(pin)){er.textContent="กรอกตัวเลข 4 หลัก";shakeEl($("pinBox"));return}
  er.textContent="กำลังค้นหาห้อง…";if(chan){chan.close();chan=null}joined=false;ROLE="player";openChan(pin);
  if(!chan){ROLE=null;er.textContent="เบราว์เซอร์นี้ไม่รองรับการเชื่อมห้อง";return}
  post({t:"join",id:myId});setTimeout(()=>{if(joined){er.textContent="";show("mProf");render();$("nmIn").focus()}
    else{ROLE=null;chan.close();chan=null;er.textContent="ไม่พบห้อง PIN นี้ ห้องต้องเปิดค้างไว้ในอีกแท็บของเบราว์เซอร์เดียวกัน";shakeEl($("pinBox"))}},900)};
$("pinIn").addEventListener("keydown",e=>{if(e.key==="Enter")$("mJoin").click()});
function pinShow(){const inp=$("pinIn"),v=inp.value.replace(/\D/g,"").slice(0,4);if(inp.value!==v)inp.value=v;
  document.querySelectorAll("#pinBox span").forEach((s,i)=>{const ch=v[i]||"";if(s.textContent!==ch){s.textContent=ch;if(ch)try{s.animate([{transform:"skewX(-10deg) scale(1.35)",background:"#ffc23d"},{transform:"skewX(-10deg) scale(1)"}],{duration:320,easing:"cubic-bezier(.2,1.6,.4,1)"})}catch(_){}}s.classList.toggle("cur",i===v.length)})}
function shakeEl(e){try{e.animate([{transform:"none"},{transform:"translateX(-14px)"},{transform:"translateX(12px)"},{transform:"translateX(-7px)"},{transform:"none"}],{duration:420})}catch(_){}}
$("pinIn").addEventListener("input",()=>{pinShow();if($("pinIn").value.length===4)blip(880,.06);else tone(660,.03,"square",.03)});
[0,1].forEach(t=>{$("tp"+t).onclick=()=>{unlock();const nm=$("nmIn").value.trim(),er=$("profErr");
  if(!nm){er.textContent="ตั้งชื่อก่อนเลือกทีม";shakeEl($("nmIn"));$("nmIn").focus();return}
  er.textContent="กำลังเข้าทีม…";pendingHello=true;post({t:"hello",id:myId,name:nm,team:t});
  setTimeout(()=>{if(pendingHello){pendingHello=false;er.textContent="ห้องไม่ตอบกลับ ลองกดเลือกทีมอีกครั้ง"}},2500)}});
function enterAsPlayer(){$("profErr").textContent="";const p=G.players.find(q=>q.id===myId),c=pchars[myId];if(c&&p)spawn(c,p);yaw=0;pitch=.3;$("menu").hidden=true;wipe();blip(660,.1);render()}
[11,22].forEach((s,i)=>$("av"+i).getContext("2d").drawImage(genFace(s*977),0,0,48,48));

/* ================= loop ================= */
let last=performance.now(),scrT=0,time=0,netT=0,lastSec=-1,lastHot=-1;const tgt=new THREE.Vector3();
function frame(now){
  requestAnimationFrame(frame);
  let dt=(now-last)/1000;last=now;if(!(dt>0))return;if(dt>.1)dt=.1;time+=dt;
  updLift(dt,time);
  const dd=G.duel;
  if(G.phase==="duel"&&dd.stage==="ask"){if(dd.open&&dd.time>0){dd.time-=dt;if(dd.time<=0){dd.time=0;if(ROLE==="mc"){say("หมดเวลา 10 วินาที · ไม่มีใครได้แต้ม");point(-1)}}}
    const s2=Math.ceil(dd.time);if(s2!==lastDs){lastDs=s2;const e=$("qcTime");e.textContent=s2;e.className="qc-time"+(s2<=3?" low":"");if(s2<=3&&s2>0&&dd.open)tone(1200,.05,"square",.03)}}
  if(G.phase==="lift"&&G.open&&G.time>0){G.time-=dt;
    if(G.time<=0){G.time=0;if(ROLE==="mc"){G.open=false;fx("timeup");endRound()}}}
  if(G.phase==="lift"&&G.ready){const s=Math.ceil(G.time);
    if(s!==lastSec){lastSec=s;const e=$("qcTime");e.textContent=s;e.className="qc-time"+(s<=10?" low":"");$("tbar").className=s<=10?"low":"";if(s<=10&&s>0&&G.open)tone(1200,.05,"square",.03)}
    $("tfill").style.transform="scaleX("+G.time/100+")"}
  /* slot-machine category spin: fast for 5 s, then slows down tick by tick */
  const sl=$("slot");
  if(G.phase==="lift"&&G.spin&&ROLE&&$("menu").hidden){
    if(sl.hidden){sl.hidden=false;spinAt=time;lastK=-1;sl.classList.remove("lock")}
    const e=time-spinAt,lastI=SCHED.length-1;let k=lastI;if(!G.same){k=0;while(k<lastI&&SCHED[k+1]<=e)k++}
    if(k!==lastK){lastK=k;const reel=G.spinCats.length?G.spinCats:CATS,ci=Math.max(0,reel.indexOf(G.cat)),n=reel.length,nm=j=>reel[((ci-(lastI-j))%n+n)%n];
      slotNames=[nm(k+1),nm(k),nm(k-1)];const sp=$("slR").children;for(let i=0;i<3;i++)sp[i].textContent=slotNames[i];spinCat=slotNames[1];
      slotLock=k===lastI;sl.classList.toggle("lock",slotLock);
      const gap=k<lastI?SCHED[k+1]-SCHED[k]:1;sl.classList.toggle("fast",gap<.1);
      if(slotLock){blip(990,.25);tone(1480,.4,"triangle",.04,.08);emit(40,1);try{$("slR").animate([{transform:"scale(1.1)"},{transform:"scale(1)"}],{duration:400,easing:"cubic-bezier(.2,1.7,.4,1)"})}catch(_){}}
      else{tone(1300+(k%3)*120,.03,"square",.028);try{$("slR").animate([{transform:"translateY(-58px)"},{transform:"translateY(0)"}],{duration:Math.min(gap*900,300),easing:"ease-out"})}catch(_){}}}
    $("slT").textContent=G.same?"หมวดเดียวกัน · หน้าชุดใหม่":"สุ่มหมวดสุดเฟี้ยว";$("slTeam").textContent="ตาของ "+G.teams[G.turn];
  }else if(!sl.hidden){sl.hidden=true;slotLock=false}
  let ix=(keys.KeyD||keys.ArrowRight?1:0)-(keys.KeyA||keys.ArrowLeft?1:0)+joy.x;
  let iy=(keys.KeyW||keys.ArrowUp?1:0)-(keys.KeyS||keys.ArrowDown?1:0)-joy.y;
  const l=Math.hypot(ix,iy);if(l>1){ix/=l;iy/=l}
  if(camSpin>0){camSpin-=dt;yaw+=dt*1.5}
  const s=Math.sin(yaw),c=Math.cos(yaw),mx=-s*iy+c*ix,mz=-c*iy-s*ix;
  const m=me(),playing=!!m&&$("menu").hidden;
  allChars().forEach(ch=>{
    if(ch.tag)ch.tag.visible=ch!==m||!playing;
    if(ch===m)stepChar(ch,dt,playing?mx:0,playing?mz:0,playing&&jumpQ);
    else if(ch.net)netChar(ch,dt);
    else stepChar(ch,dt,0,0,false);
  });
  jumpQ=false;
  if(m&&myMark.parent!==m.g)m.g.add(myMark);myMark.visible=playing;myMark.position.y=3.15+Math.sin(time*4)*.06;
  if(chan&&m&&ROLE&&!pendingHello){netT-=dt;if(netT<=0){netT=.08;post({t:"pos",id:ROLE==="mc"?"mc":myId,x:m.x,y:m.y,z:m.z,rot:m.rot,riding:m.riding,on:m.on})}}
  updGuide(time);updPods(dt,time);
  fovK-=fovK*Math.min(1,dt*6);camera.fov=60-fovK;camera.updateProjectionMatrix();
  $("app").classList.toggle("tense",G.phase==="lift"&&G.open&&G.time<=10&&G.time>0);
  let cd=dist,cpi=pitch;
  if(playing)tgt.set(m.x,m.y+1.5,m.z);else{yaw+=dt*.12;tgt.set(0,4,-2);cd=15;cpi=.16}
  const cp=Math.cos(cpi);
  let cx=tgt.x+cd*Math.sin(yaw)*cp,cy=tgt.y+cd*Math.sin(cpi),cz=tgt.z+cd*Math.cos(yaw)*cp;
  if(playing&&m.riding&&m.y<-.3){cx=clamp(cx,LX-HH+.3,LX+HH-.3);cz=clamp(cz,LZ-HH+.3,LZ+HH-.3);cy=clamp(cy,-6.8,RH-.5)}
  else{cx=clamp(cx,-RX+.4,RX-.4);cz=clamp(cz,-RZ+.4,RZ-.4);cy=clamp(cy,.35,RH-.4)}
  if(shakeT>0){shakeT-=dt;cx+=(Math.random()-.5)*.3;cy+=(Math.random()-.5)*.3}
  camera.position.set(cx,cy,cz);camera.lookAt(tgt);
  const h=$("hint");
  if(!playing)h.hidden=true;
  else if(time<hintUntil){h.hidden=false;h.textContent=hintMsg}
  else if(m.riding){h.hidden=false;h.textContent=liftOpen?"เดินออกทางประตูได้เลย (หรือกด E)":"กด E เพื่อลงจากลิฟต์"}
  else if(guideOn&&ROLE==="player"&&myTeam()===G.turn){h.hidden=false;h.textContent=nearLift(m)?(liftOpen?"ประตูเปิดแล้ว · เดินเข้าลิฟต์ได้เลย":"รอลิฟต์ลงมาที่ชั้นล่าง…"):"ตาทีมคุณ · เดินตามลูกศรไปขึ้นลิฟต์"}
  else if(guideOn){h.hidden=false;h.textContent=ROLE==="mc"?"รอผู้เล่น "+G.teams[G.turn]+" ขึ้นลิฟต์":"รอ "+G.teams[G.turn]+" ขึ้นลิฟต์"}
  else h.hidden=true;
  lights(dt,time);
  mcT-=dt;if(mcT<=0){mcT=.16;drawMcMon(time)}
  signT-=dt;if(signT<=0){signT=1/15;sign.draw(time);sign.halo.material.opacity=.32+.14*Math.sin(time*2)}
  scrT-=dt;if(scrT<=0||G.spin){scrT=(G.phase==="lift"&&G.ready)||G.phase==="duel"?.033:.1;drawScreen(time);if(!$("qcard").hidden&&view().blind)drawFace($("qcImg"),null,true)}
  renderer.render(scene,camera);
}
render();drawScreen(0);requestAnimationFrame(frame);
if(document.fonts&&document.fonts.ready)document.fonts.ready.then(()=>{drawScreen(time);pods.forEach(p=>{p.key=""})});
window.__game={colliders,holeCol,cabCol,liftOpen:()=>liftOpen,sign,G,mcChar,pchars,lift,blocked,view,bank,mcMon,me:()=>me()};
})();
