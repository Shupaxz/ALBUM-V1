/* slot machine category spin */
#slot{position:absolute;left:50%;top:47%;transform:translate(-50%,-50%);width:min(660px,calc(100% - 48px));display:flex;flex-direction:column;align-items:center;pointer-events:none;animation:slotIn .55s cubic-bezier(.2,1.4,.4,1)}
